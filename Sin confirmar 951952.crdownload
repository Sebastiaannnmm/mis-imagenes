import fetch from 'node-fetch';
import { getDevice } from '@whiskeysockets/baileys';
import fs from 'fs';
import axios from 'axios';
import moment from 'moment-timezone';
import { bodyMenu, menuObject } from '../../core/commands.js';

function normalize(text = '') {
  if (!text) return '';
  text = text.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '');
  return text.endsWith('s') ? text.slice(0, -1) : text;
}

export default {
  command: ['allmenu', 'help', 'menu'],
  category: 'info',
  run: async (client, m, args, usedPrefix, command) => {
    try {
      const safeArgs = Array.isArray(args) ? args : [];
      const firstArg = safeArgs[0] || '';

      const now = new Date();
      const timeZone = 'America/Caracas';
      const tiempo = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/,/g, '');
      const tempo = moment.tz(timeZone).format('hh:mm A');
      
      const botId = client?.user?.id.split(':')[0] + '@s.whatsapp.net';
      const botSettings = global.db.data?.settings?.[botId] || {};
      const botname = botSettings.botname || 'Dororo Bot';
      const canalId = botSettings.id || '';
      const canalName = botSettings.nameid || 'Dororo Updates';
      
      const users = Object.keys(global.db.data?.users || {}).length;
      const device = getDevice(m.key.id);
      
      const sender = global.db.data?.users?.[m.sender]?.name || m.pushName || m.sender.split('@')[0];
      const uptime = client.uptime ? formatearMs(Date.now() - client.uptime) : "Desconocido";

      const videoUrl = 'https://github.com/Sebastiaannnmm/mis-imagenes/raw/main/From%20KlickPin%20CF%20Local%20global%20food%20memories%20and%20clever%20inspiration%20with%20easy%20charm%20for%20culture-rich%20mood%20boards%20%F0%9F%8E%92%20-%20Pin-891360951237587643.mp4';

      const alias = {
        anime: ['anime', 'reacciones'],
        downloads: ['downloads', 'descargas'],
        economia: ['economia', 'economy', 'eco'],
        gacha: ['gacha', 'rpg'],
        grupo: ['grupo', 'group'],
        nsfw: ['nsfw', '+18'],
        profile: ['profile', 'perfil'],
        sockets: ['sockets', 'bots'],
        stickers: ['stickers', 'sticker'],
        utils: ['utils', 'utilidades', 'herramientas']
      };

      const input = normalize(firstArg);
      const cat = Object.keys(alias).find(k => alias[k].map(normalize).includes(input));
      const categoryLabel = cat ? ` para la senda de \`${cat}\`` : '. *(˶ᵔ ᵕ ᵔ˶)*';

      if (firstArg && !cat) {      
        return m.reply(`《✧》 La categoria *${firstArg}* no existe.\n> Categorias: *${Object.keys(alias).join(', ')}*`);
      }

      const sections = menuObject;
      const content = cat ? String(sections[cat] || '') : Object.values(sections).map(s => String(s || '')).join('\n\n');

      let menu = `
╭─── [ 🏮 *${botname}* ] ───···
│
│ 👹 *Viajero:* ${sender}
│ ⚔️ *Uptime:* ${uptime}
│ 🏮 *Prefijo:* [ ${usedPrefix || '/'} ]
│ 📜 *Fecha:* ${tiempo}
│ ⏳ *Hora:* ${tempo}
│ 👤 *Usuarios:* ${users}
│ 🛠️ *Dispositivo:* ${device}
│
│> *Buscando las partes perdidas de Hyakkimaru...*
╰──────────────────────────···

*LISTA DE COMANDOS* ${categoryLabel}

${content}
`.trim();

      // DESCARGA DEL VIDEO PARA EVITAR EL ERROR DE CARGA
      const response = await axios.get(videoUrl, { responseType: 'arraybuffer' });
      const videoBuffer = Buffer.from(response.data, 'binary');

      await client.sendMessage(m.chat, {
        video: videoBuffer, // Enviamos el archivo real
        caption: menu,
        gifPlayback: false, // NO ES UN GIF, ES VIDEO REAL
        mimetype: 'video/mp4',
        fileName: `menu.mp4`,
        contextInfo: {
          mentionedJid: [m.sender],
          isForwarded: true,
          forwardedNewsletterMessageInfo: {
            newsletterJid: canalId,
            serverMessageId: '',
            newsletterName: canalName
          }
        }
      }, { quoted: m });

      // MENSAJE DE CONTACTO APARTE
      const contactMsg = `
─── [ 🧧 *CONTACTO DEL DUEÑO* ] ───

🏮 *WhatsApp:* +52 449 578 7323
⛩️ *Instagram:* https://www.instagram.com/b4an_j?igsh=cjc1cjA0dHZmeGJt

> *Contacta al creador si necesitas ayuda.*`.trim();

      await client.sendMessage(m.chat, { text: contactMsg }, { quoted: m });

    } catch (e) {
      console.error(e);
      await m.reply(`> 🏮 *Error en el pergamino:* ${e.message}`);
    }
  }
};

function formatearMs(ms) {
  if (typeof ms !== 'number') return '0s';
  let segundos = Math.floor(ms / 1000) % 60;
  let minutos = Math.floor(ms / (1000 * 60)) % 60;
  let horas = Math.floor(ms / (1000 * 60 * 60));
  return `${horas}h ${minutos}m ${segundos}s`;
}